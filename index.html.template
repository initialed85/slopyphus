<!doctype html>
<!--
  Rendered by /docker-entrypoint.nginx.sh into /usr/share/nginx/html/index.html.

  The structure below is generic on purpose: a group is a set of panes that share one half of the
  viewport and split it equally, and the entrypoint decides which groups exist, in which order, and
  how many panes each holds. Nothing here knows the name of an agent.

  Substituted in by the entrypoint (the markers are lines, so each has its own line here):
    GRID_CSS    the one rule that splits the viewport between the two groups (1fr 1fr, either axis)
    GROUPS      the pane markup: a group-columns / group-rows div of cell divs, each holding an iframe
    PAGE_TITLE  inline in the title element below
-->
<html>
  <head>
    <meta charset="utf-8" />
    <title>@@PAGE_TITLE@@</title>
    <style>
      /* The desktop's own scrollbars. Worth being explicit about the scope: an iframe is a document of
         its own and nothing in this <style> reaches the page inside a pane. That half of the problem is
         handled by PANE_SCROLLBAR_CSS in the script below. */
      ::-webkit-scrollbar {
        display: none;
      } /* Chrome, Safari, Edge */
      * {
        scrollbar-width: none;
      } /* Firefox, and Chrome 121+ */
      html,
      body {
        margin: 0;
        height: 100%;
        /* This page is a fixed grid, not a document with content to reach: #wrap is 100vh of panes and
           there is nothing below it. Clipping is the guarantee that no scrollbar of the desktop's own can
           ever appear, because one of those costs a strip of width from every pane at once. The two rules
           that used to make it overflow (an inline iframe, and a label wider than its pane) are fixed
           below rather than hidden here. */
        overflow: hidden;
        background: #111;
        color: #ccc;
        font: 12px monospace;
      }
      #wrap {
        display: grid;
        height: 100vh;
      }
@@GRID_CSS@@
      .group {
        display: grid;
        min-width: 0;
        min-height: 0;
      }
      /* A "columns" group is equal-width strips spanning the full height of its half; a "rows" group is
         equal-height bands spanning the full width of its half. auto-flow + auto-tracks mean the split
         is equal for any number of panes, including one. */
      .group-columns {
        grid-auto-flow: column;
        grid-auto-columns: minmax(0, 1fr);
      }
      .group-rows {
        grid-auto-flow: row;
        grid-auto-rows: minmax(0, 1fr);
      }
      .cell {
        position: relative;
        min-width: 0;
        min-height: 0;
      }
      iframe {
        /* An iframe is an inline replaced element by default, so it sits on the line's baseline and the
           line box is the iframe plus the font's descent below it: 3px taller than the viewport at 12px
           monospace, which is a vertical scrollbar on the desktop. Block level, and it fills the cell. */
        display: block;
        width: 100%;
        height: 100%;
        min-width: 0;
        min-height: 0;
        border: 1px solid #fff;
        box-sizing: border-box;
      }
      /* Which agent is which, without asking every upstream (a proxied ttyd page says "ttyd").
         pointer-events: none so a label can never steal a click or a keystroke from a terminal. */
      .tag {
        position: absolute;
        box-sizing: border-box; /* so the max-width below is the whole label, padding included */
        top: 2px;
        left: 4px;
        padding: 0 3px;
        background: rgba(17, 17, 17, 0.75);
        color: #777;
        pointer-events: none;
        z-index: 2;
        /* A label is absolutely positioned inside a cell that is position:relative, so a label wider than
           its pane is overflow that the cell does not stop: with 20 panes at 40px each, "minecraft-pinger"
           measured 78px wide and pushed the page to 842px in an 800px viewport, which is a horizontal
           scrollbar on the desktop and a label printed over its neighbour's terminal. Ellipsis instead. */
        white-space: nowrap;
        max-width: calc(100% - 8px); /* the 4px inset on the left, mirrored on the right */
        overflow: hidden;
        text-overflow: ellipsis;
      }
      #wrap iframe.focused {
        border-color: #00e676;
      }
      body.broadcasting #wrap iframe,
      body.broadcasting #wrap iframe.focused {
        border-color: #ff3b30;
      }
      body.iframe-expanded {
        overflow: hidden;
      }
      body.iframe-expanded #wrap > * {
        visibility: hidden;
      }
      /* The expanded pane is pulled out of its group rather than resized within it, so the grid never
         re-flows: everything else stays exactly where it was for when the pane is put back. */
      body.iframe-expanded #wrap iframe.expanded {
        visibility: visible;
        position: fixed;
        inset: 0;
        z-index: 1000;
        width: 100vw;
        height: 100vh;
      }
    </style>
  </head>
  <body>
    <div id="wrap">
@@GROUPS@@
    </div>
    <script>
      const frames = Array.from(document.querySelectorAll("#wrap iframe"));
      const boundDocuments = new WeakSet();
      const styledDocuments = new WeakSet();
      const relayedKeyEvents = new WeakSet();
      let activeFrame = null;
      let expandedFrame = null;
      let broadcasting = false;

      function focusFrame(frame) {
        try {
          frame.focus();
          frame.contentWindow.focus();
          const terminalInput = frame.contentDocument.querySelector(".xterm-helper-textarea");
          if (terminalInput) terminalInput.focus({ preventScroll: true });
        } catch (_) {
          // The frame may not have finished loading yet.
        }
      }

      function setActiveFrame(frame) {
        if (!frame || activeFrame === frame) return;
        if (activeFrame) activeFrame.classList.remove("focused");
        activeFrame = frame;
        activeFrame.classList.add("focused");
        focusFrame(frame);
      }

      function clearActiveFrame() {
        if (!activeFrame) return;
        activeFrame.classList.remove("focused");
        try {
          activeFrame.contentDocument.activeElement.blur();
        } catch (_) {
          // The frame may have navigated while losing focus.
        }
        activeFrame = null;
      }

      function isChord(event, key) {
        return event.altKey && event.shiftKey && !event.ctrlKey && !event.metaKey && event.key.toLowerCase() === key;
      }

      function handleBroadcastShortcut(event) {
        if (!isChord(event, "g")) return false;
        event.preventDefault();
        event.stopImmediatePropagation();
        if (event.type === "keydown" && !event.repeat) {
          broadcasting = !broadcasting;
          document.body.classList.toggle("broadcasting", broadcasting);
        }
        return true;
      }

      function handleShortcut(event, sourceFrame) {
        if (!isChord(event, "enter")) return false;
        event.preventDefault();
        event.stopImmediatePropagation();
        if (event.type !== "keydown" || event.repeat) return true;

        const targetFrame = activeFrame ?? sourceFrame;
        if (!targetFrame) return true;
        if (expandedFrame) {
          expandedFrame.classList.remove("expanded");
          document.body.classList.remove("iframe-expanded");
          expandedFrame = null;
        } else {
          expandedFrame = targetFrame;
          expandedFrame.classList.add("expanded");
          document.body.classList.add("iframe-expanded");
        }
        focusFrame(targetFrame);
        return true;
      }

      function dispatchKeyboard(frame, type, init, relayed = false) {
        try {
          const target = frame.contentDocument.querySelector(".xterm-helper-textarea");
          if (!target) return;
          const event = new KeyboardEvent(type, init);
          if (relayed) relayedKeyEvents.add(event);
          target.dispatchEvent(event);
        } catch (_) {
          // The target frame may not have finished loading or may have navigated.
        }
      }

      /*
       * Shift+Enter is not handled here any more, and the reason is worth keeping.
       *
       * xterm.js evaluates Enter without consulting Shift (src/common/input/Keyboard.ts, case 13:
       * `ev.altKey ? ESC+CR : CR`), so a pane cannot tell Shift+Enter from Enter, and this page used to
       * intercept the keystroke and inject a synthesised Ctrl+J into the focused pane's textarea instead.
       * That fixed the panes this page frames and left every pane reached directly - a node port, an
       * agent's own URL - broken, which is the complaint the fix is measured against.
       *
       * The translation now happens inside ttyd's client (vendor/ttyd/html/src/components/terminal/xterm,
       * the onKey handler), so it applies to a pane however the pane was opened, and this page is not in
       * the business of rewriting keys it is only relaying.
       */

      function relayKeyboard(event, sourceFrame) {
        if (!broadcasting) return;
        if (!sourceFrame) event.preventDefault();
        const init = {
          key: event.key,
          code: event.code,
          location: event.location,
          ctrlKey: event.ctrlKey,
          shiftKey: event.shiftKey,
          altKey: event.altKey,
          metaKey: event.metaKey,
          repeat: event.repeat,
          isComposing: event.isComposing,
          keyCode: event.keyCode,
          which: event.which,
          bubbles: true,
          cancelable: true,
          composed: true,
        };
        for (const frame of frames) {
          if (frame !== sourceFrame) dispatchKeyboard(frame, event.type, init, true);
        }
      }

      function handleFrameKeyboard(event, sourceFrame) {
        if (relayedKeyEvents.has(event)) return;
        if (handleBroadcastShortcut(event)) return;
        if (handleShortcut(event, sourceFrame)) return;
        relayKeyboard(event, sourceFrame);
      }

      /*
       * The pane half of the scrollbar problem.
       *
       * A pane's scrollbars belong to the document inside the iframe, which the page above cannot style,
       * so they have to be hidden from inside. That is possible because every upstream is framed through
       * nginx under this page's own origin (/name/), which makes the pane same-origin (except a site that
       * answers with a redirect: the browser then leaves the front and the pane really is cross-origin).
       *
       * The case that matters is ttyd, which is what a pane usually shows here. xterm's own CSS is
       * `.xterm .xterm-viewport{...overflow-y:scroll...}`: a scroll container that always asks for a bar,
       * and in a browser where a scrollbar takes layout space that is a strip down the right of every
       * terminal on the desktop, whether or not the terminal has any scrollback to show.
       *
       * Both spellings are emitted because they are not interchangeable. `scrollbar-width` is the standard
       * property (Firefox, Chrome 121+); `::-webkit-scrollbar` is what older Blink and WebKit have, and in
       * that mode `display: none` hides the bar but leaves the gutter reserved while `width: 0` collapses
       * it. Hiding a bar without giving its area back is the whole complaint, so the webkit half uses 0.
       *
       * Nothing here sets overflow: hidden on a pane. A pane whose content is taller than the pane is
       * still scrollable by wheel or keyboard; it just no longer pays for the privilege in layout.
       */
      const PANE_SCROLLBAR_CSS = "::-webkit-scrollbar{width:0!important;height:0!important}*{scrollbar-width:none!important}";

      function styleFrameDocument(frame) {
        try {
          const frameDocument = frame.contentDocument;
          if (!frameDocument || !frameDocument.head || styledDocuments.has(frameDocument)) return;
          styledDocuments.add(frameDocument);
          const style = frameDocument.createElement("style");
          // Appended last, so this wins a tie against whatever the upstream ships; !important covers the
          // rest, because an upstream is entitled to style its own scrollbars and the desktop disagrees.
          style.id = "slopyphus-pane-scrollbars";
          style.textContent = PANE_SCROLLBAR_CSS;
          frameDocument.head.appendChild(style);
        } catch (_) {
          // A cross-origin frame cannot be styled from here either.
        }
      }

      function bindFrameDocument(frame) {
        try {
          const frameDocument = frame.contentDocument;
          if (!frameDocument || boundDocuments.has(frameDocument)) return;
          boundDocuments.add(frameDocument);
          ["pointerover", "pointermove", "pointerdown"].forEach((type) => {
            frameDocument.addEventListener(type, () => setActiveFrame(frame), true);
          });
          ["keydown", "keyup"].forEach((type) => {
            frameDocument.addEventListener(type, (event) => handleFrameKeyboard(event, frame), true);
          });
          styleFrameDocument(frame);
        } catch (_) {
          // A cross-origin frame cannot be inspected for its pointer or keyboard events.
        }
      }

      frames.forEach((frame) => {
        frame.addEventListener("pointerenter", () => setActiveFrame(frame));
        frame.addEventListener("pointerdown", () => setActiveFrame(frame));
        frame.addEventListener("focus", () => setActiveFrame(frame));
        frame.addEventListener("load", () => {
          bindFrameDocument(frame);
          // Not every pane fires load the way the front expects (a proxied page that navigates itself,
          // or one that was already bound by a pointer event before load), so the style is asked for
          // again here. styleFrameDocument is idempotent per document.
          styleFrameDocument(frame);
          if (activeFrame === frame) focusFrame(frame);
        });
        bindFrameDocument(frame);
      });

      document.addEventListener("pointermove", (event) => {
        if (frames.includes(event.target)) setActiveFrame(event.target);
        else clearActiveFrame();
      }, true);
      ["keydown", "keyup"].forEach((type) => {
        document.addEventListener(type, (event) => handleFrameKeyboard(event, null), true);
      });
    </script>
  </body>
</html>
