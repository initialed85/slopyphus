# Rendered by /docker-entrypoint.nginx.sh into /etc/nginx/conf.d/default.conf.
# Edit this template (or the container's COLUMNS / ROWS / LAYOUT), never the rendered file: a config
# that has been hand-edited inside a container is a config that cannot be reproduced by anything.

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen 80;
  server_name _;

  # Redirects are relative, because this front is always behind something that terminates TLS. Inside
  # the container $scheme is http whatever the browser used, and an absolute Location would rewrite
  # https://host/x to http://host/x. Measured on the dev cluster: `return 308 /home-ops/` answered
  # `Location: http://slopyphus.dev.initialed85.cc/home-ops/` even with X-Forwarded-Proto: https, and a
  # 308 is cacheable, so the browser kept re-entering over plain http. The oauth2-proxy session and
  # CSRF cookies are Secure, so on http they are neither sent nor stored: the pane demanded a sign-in,
  # and that sign-in then died at the callback with "Cookies were found in OAuth callback, but none was
  # a CSRF cookie". A relative Location is resolved against the URL the browser is already on, so the
  # scheme the user arrived with survives.
  absolute_redirect off;
  # Same reason, for the container's own port: a bare name keeps the redirect on whatever the client
  # used rather than leaking 80 (or a NodePort) into a URL.
  port_in_redirect off;

  root /usr/share/nginx/html;
  # The front no longer renders an index.html: tab 1 is tab-1.html like every other tab, and the entrypoint
  # removes any index.html left behind (nginx's own welcome page included). This directive is the belt; the
  # entrypoint's `location = /` is the braces, since that location is also where a request for the landing
  # page picks up Cache-Control: no-store.
  index tab-1.html;

  # Reserved name; an agent may not be called "healthz" (the entrypoint enforces it).
  # Answers even when every agent upstream is down, so a Kubernetes probe measures this container
  # rather than the desktop it fronts.
  location = /healthz {
    add_header Content-Type text/plain;
    return 200 "ok\n";
  }

  # ttyd is a websocket terminal: the upgrade handshake has to survive the proxy, and a live terminal
  # must not be buffered. read_timeout matters because a detached tmux session is a websocket that
  # produces no output for a long time.
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $connection_upgrade;
  proxy_read_timeout 1h;
  proxy_buffering off;

@@RESOLVER@@
@@AGENT_LOCATIONS@@
}
